---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnerLogos from '../components/PartnerLogos.astro';
import WorkCards from '../components/WorkCards.astro';
import HomeConnect from '../components/home/HomeConnect.astro';
import { supportLinks } from '../data/site';
import instruments from '../assets/images/field/latest-instruments.jpg';
import shadia from '../assets/images/field/shadia-habbal.jpg';
import team from '../assets/images/field/latest-team.jpg';
import totality from '../assets/images/field/burgos-totality.jpg';
import fieldSetup from '../assets/images/field/burgos-workshop.jpg';
import observer from '../assets/images/work/research.jpg';
import '../styles/work.css';
import '../styles/about.css';

const expeditionHref = '/latest-expedition#team';

const storyHighlights = [
	{ id: 'lead', label: 'Highlight' },
	{ id: 'a', label: 'Highlight' },
	{ id: 'b', label: 'Highlight' },
	{ id: 'c', label: 'Highlight' },
] as const;

const peopleFrames = [
	{ id: 'hero', label: 'Portrait' },
	{ id: 'a', label: 'Photo' },
	{ id: 'b', label: 'Photo' },
	{ id: 'c', label: 'Photo' },
	{ id: 'd', label: 'Photo' },
	{ id: 'e', label: 'Photo' },
] as const;

const introMontage = [
	{
		image: team,
		alt: 'Solar Wind Sherpas team members gathered around a telescope in Burgos',
		area: 'people',
		position: '54% 38%',
	},
	{
		image: totality,
		alt: 'Total solar eclipse over the Burgos ridge, with telescopes in the foreground',
		area: 'landscape',
		position: '50% 28%',
	},
	{
		image: observer,
		alt: 'A researcher in a Solar Wind Sherpas shirt operating a camera in the field',
		area: 'observer',
		position: '35% 40%',
	},
	{
		image: fieldSetup,
		alt: 'Two team members assembling custom solar instruments at a work table',
		area: 'setup',
		position: '50% 42%',
	},
	{
		image: instruments,
		alt: 'Custom solar instruments and a field laptop on the Burgos ridge',
		area: 'gear',
		position: '28% 52%',
	},
] as const;
---

<BaseLayout
	title="About"
	description="Solar Wind Sherpas is an expeditionary collaboration, founded and led by Dr. Shadia Habbal, that studies the solar corona from the path of totality."
>
	<article class="page about">
		<section class="about-intro" id="introduction" aria-labelledby="about-heading">
			<div class="page-narrow">
				<p class="label page-kicker">About</p>
				<h1 id="about-heading">A collaboration that goes to the path of totality.</h1>
				<p class="about-facts">31 years · 21 expeditions · 40+ peer-reviewed publications</p>
				<p>
					Founded and led by solar physicist Dr. Shadia Habbal, Solar Wind Sherpas deploys portable
					observatories to total solar eclipses worldwide — to study the corona and the origins of
					the solar wind.
				</p>
			</div>
			<figure class="about-media reveal">
				<div
					class="about-montage"
					role="group"
					aria-label="People, landscapes and instruments from Solar Wind Sherpas expeditions"
				>
					{
						introMontage.map((shot, index) => (
							<div
								class:list={['about-montage-item', `about-montage-item--${shot.area}`]}
								style={`--shot-pos: ${shot.position}`}
							>
								<Image
									src={shot.image}
									alt={shot.alt}
									widths={[480, 800, 1200]}
									sizes={
										shot.area === 'people'
											? '(max-width: 900px) 50vw, 28vw'
											: '(max-width: 900px) 50vw, 36vw'
									}
									loading={index === 0 ? 'eager' : 'lazy'}
									class="about-montage-photo"
								/>
							</div>
						))
					}
				</div>
				<!-- Review: add identified photographs from earlier expeditions when Danilo/Shadia send them -->
				<figcaption>Burgos, Spain · 2026</figcaption>
			</figure>
		</section>

		<section class="about-block" id="our-story" aria-labelledby="story-heading">
			<div class="page-narrow">
				<h2 id="story-heading">Our Story</h2>
				<p>
					Dr. Shadia Habbal founded Solar Wind Sherpas in 1995 and has led every expedition since.
				</p>
			</div>
			<div class="about-highlights" role="list" aria-label="Story highlights, awaiting copy">
				{
					storyHighlights.map((moment) => (
						<article
							class:list={['about-highlight', `about-highlight--${moment.id}`]}
							role="listitem"
						>
							<p class="label">{moment.label}</p>
							<p class="about-highlight-year">Year</p>
							<span class="about-wire-line"></span>
							<span class="about-wire-line about-wire-line--short"></span>
						</article>
					))
				}
			</div>
		</section>

		<section class="about-founder" id="founder" aria-labelledby="founder-heading">
			<article class="about-card about-featured reveal">
				<div class="about-card-photo about-featured-photo">
					<Image
						src={shadia}
						alt="Dr. Shadia Habbal smiling in the field"
						widths={[640, 960, 1024]}
						sizes="(max-width: 900px) 92vw, 42vw"
						class="about-card-img about-featured-img"
					/>
				</div>
				<div class="about-card-copy">
					<p class="label">Founder</p>
					<h3 id="founder-heading">Dr. Shadia R. Habbal</h3>
					<p class="about-featured-affiliation">
						Professor and Astronomer, Institute for Astronomy, University of Hawaiʻi
					</p>
					<p>
						Born in Syria, she earned her Ph.D. in Physics from the University of Cincinnati in 1977.
						After more than two decades at the Smithsonian Astrophysical Observatory and Harvard, she
						joined the Institute for Astronomy in 2005. She is Lead Editor of the Astrophysical
						Journal.
					</p>
					<p>
						She founded Solar Wind Sherpas in 1995 and has led every expedition since. Findings have
						been featured in <em>Science</em>. The work has been recognized with a NASA Certificate
						of Appreciation and an Honorary Doctorate from Brno University of Technology.
					</p>
				</div>
			</article>
		</section>

		<section class="about-people" id="people" aria-labelledby="people-heading">
			<div class="about-people-gallery">
				<div class="about-people-copy">
					<h2 id="people-heading">The People Behind the Sherpas</h2>
					<p>
						Each expedition brings together the scientists, engineers and observers needed for those
						minutes — including graduate students and early-career researchers in the field.
						Participants are listed with the expedition they joined.
					</p>
					<a class="cta" href={expeditionHref}>
						See who was in the field in Burgos <span class="cta-arrow" aria-hidden="true">→</span>
					</a>
				</div>
				{
					peopleFrames.map((frame) => (
						<div
							class:list={['about-wire', 'about-people-frame', `about-people-frame--${frame.id}`]}
							aria-hidden="true"
						>
							<span class="about-wire-label">{frame.label}</span>
						</div>
					))
				}
			</div>
		</section>

		<section class="about-suite" id="actions" aria-labelledby="actions-heading">
			<div class="about-suite-block">
				<header class="about-suite-head">
					<h2 id="actions-heading">Our Actions</h2>
					<p>
						We bring solar research into the field and share the science of eclipses with the
						communities we meet.
					</p>
				</header>
				<WorkCards />
			</div>
		</section>

		<section class="about-block about-partners" id="partners" aria-labelledby="about-partners-heading">
			<div class="page-narrow">
				<h2 id="about-partners-heading">Partners &amp; Supporters</h2>
			</div>
			<PartnerLogos />
		</section>

		<section class="about-support" id="support" aria-labelledby="about-support-heading">
			<div class="page-narrow">
				<p class="label">Support our work</p>
				<h2 id="about-support-heading">Help make eclipse science possible.</h2>
				<p>
					If you or your organization would like to help sustain future expeditions and scientific
					research, <a href="#contact">we would welcome a conversation</a>.
				</p>
				<p>
					You can also support the project in a way that works for you: join us on Patreon for
					ongoing support, or make a one-time contribution through Buy Me a Coffee. Every
					contribution helps us carry this work forward.
				</p>
				<ul class="about-support-funds">
					<li>
						<p class="about-support-fund-title">Expedition sponsorship</p>
						<p>Travel, field equipment, and operations across observing sites.</p>
					</li>
					<li>
						<p class="about-support-fund-title">Data analysis</p>
						<p>The years of work that turn eclipse observations into papers.</p>
					</li>
					<li>
						<p class="about-support-fund-title">Instrumentation</p>
						<p>Spectrometers, filters and cameras built for the path of totality.</p>
					</li>
					<li>
						<p class="about-support-fund-title">Early-career scientists</p>
						<p>Students and researchers who learn this science in the field.</p>
					</li>
				</ul>
				<div class="about-support-cta">
					{
						supportLinks.map((link) => (
							<a
								class="cta cta--button"
								href={link.href}
								rel="noopener noreferrer"
								target="_blank"
							>
								{link.label} <span class="cta-arrow" aria-hidden="true">→</span>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<HomeConnect />
	</article>
</BaseLayout>
