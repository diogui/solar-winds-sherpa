/**
 * Canonical About at `/about`.
 * Switch versions in `src/data/about-version.ts` (`atual` | `chat` | `more`).
 * Direct URLs always available: /about-atual · /about-chat · /about-more
 */
import { aboutVersion, aboutVersionMeta } from '../data/about-version';

return Astro.rewrite(aboutVersionMeta[aboutVersion].path);
