---

<BaseLayout
	title="Latest Expedition"
	description="Burgos, Spain, 2026. Solar Wind Sherpas observed the total solar eclipse from Padilla de Abajo and Pico Trigaza."
>
	<article class="page exp">
		<section class="exp-open" id="burgos-2026" aria-labelledby="exp-heading">
			<div class="page-narrow exp-open-copy">
				<p class="label page-kicker">Latest expedition · 2026</p>
				<h1 id="exp-heading">Burgos, Spain</h1>
				<p class="exp-facts">12 August 2026 · Padilla de Abajo · Pico Trigaza</p>
				<p>
					The greatest challenge was observing an eclipse so low on the horizon — about eight degrees —
					without interference from the landscape.
				</p>
			</div>

			<div class="exp-hero" data-cut-switch data-active-cut="full">
				<div class="exp-hero-chrome">
					<button type="button" class="exp-hero-mute" data-exp-mute aria-label="Mute sound" aria-pressed="false">
						<span class="exp-hero-mute-icon" data-exp-mute-icon aria-hidden="true">
							<svg class="exp-hero-mute-on" viewBox="0 0 24 24" width="18" height="18" fill="none">
								<path
									d="M4 10.5v3h3.2L11 17V7L7.2 10.5H4Z"
									fill="currentColor"></path>
								<path
									d="M14.2 9.2a3.6 3.6 0 0 1 0 5.6M16.6 7a6.4 6.4 0 0 1 0 10"
									stroke="currentColor"
									stroke-width="1.7"
									stroke-linecap="round"></path>
							</svg>
							<svg class="exp-hero-mute-off" viewBox="0 0 24 24" width="18" height="18" fill="none">
								<path
									d="M4 10.5v3h3.2L11 17V7L7.2 10.5H4Z"
									fill="currentColor"></path>
								<path
									d="M15 9.5 20 14.5M20 9.5 15 14.5"
									stroke="currentColor"
									stroke-width="1.7"
									stroke-linecap="round"></path>
							</svg>
						</span>
					</button>
					<button type="button" class="exp-hero-close" data-exp-close aria-label="Exit film">
						<span aria-hidden="true">×</span>
					</button>
				</div>
				<p class="exp-rotate-hint" data-exp-rotate-hint hidden>
					<span class="exp-rotate-hint-icon" aria-hidden="true">↻</span>
					<span class="exp-rotate-hint-text">Rotate your phone to watch the film in full screen.</span>
				</p>
				<div class="exp-hero-frame">
					<div
						class="exp-hero-panel"
						data-cut="full"
						data-exp-src={hasFull ? fullSrc : undefined}
						data-exp-src-light={hasFull ? fullSrcLight : undefined}
						data-exp-skip-start={hasFull ? '5' : undefined}
						data-exp-skip-tail={hasFull ? '4.3' : undefined}
						data-exp-preload="auto"
					>
						{
							hasFull ? (
								<>
									<video
										class="exp-hero-video"
										data-exp-video
										playsinline
										preload="auto"
										poster={fullPoster}
										aria-label="Burgos expedition film by Santiago Marrodán Ciordia"
									></video>
									<img
										class="exp-hero-still"
										src={fullPoster}
										alt=""
										width="1600"
										height="900"
										decoding="async"
									/>
									<button class="exp-play" type="button" data-exp-play aria-label="Play video">
										<span data-exp-play-label>Play</span>
									</button>
									<div
										class="exp-hero-load"
										data-exp-load
										role="progressbar"
										aria-label="Film download"
										aria-valuemin="0"
										aria-valuemax="100"
										aria-valuenow="0"
									>
										<span class="exp-hero-load-bar" data-exp-load-bar></span>
									</div>
								</>
							) : (
								<Image
									src={padillaCamp}
									alt="Two team members in purple expedition shirts at the Padilla de Abajo field camp, beside grey observation tents"
									widths={[960, 1400, 1800]}
									sizes="(max-width: 900px) 94vw, 88vw"
									class="exp-hero-photo"
								/>
							)
						}
					</div>
					{
						hasQuick && (
							<div
								class="exp-hero-panel"
								data-cut="quick"
								data-exp-src={quickSrc}
								data-exp-preload="none"
								data-exp-muted="true"
							>
								<video
									class="exp-hero-video exp-hero-video--quick"
									data-exp-video
									muted
									playsinline
									preload="none"
									poster={quickPoster}
									aria-label="Burgos expedition highlight"
								></video>
								<img
									class="exp-hero-still exp-hero-still--quick"
									src={quickPoster}
									alt=""
									width="1600"
									height="900"
									decoding="async"
								/>
								<button class="exp-play" type="button" data-exp-play aria-label="Play video">
									<span data-exp-play-label>Play</span>
								</button>
							</div>
						)
					}
					{
						hasFull && hasQuick && (
							<div class="exp-hero-controls">
								<button type="button" class="exp-site-btn" data-cut="quick" aria-pressed="false">
									Quick
								</button>
								<button type="button" class="exp-site-btn" data-cut="full" aria-pressed="true">
									Full
								</button>
							</div>
						)
					}
				</div>
				{hasFull && <p class="exp-hero-credit">Film by Santiago Marrodán Ciordia</p>}
			</div>
		</section>

		<section class="exp-block exp-sites" id="mission" aria-labelledby="mission-heading" data-burgos-filter>
			<div class="page-narrow">
				<p class="label">Two observing sites</p>
				<h2 id="mission-heading">Two sites, one eclipse.</h2>
				<p>
					There is not usually a specific scientific goal for one expedition. The work is to build a
					larger, cumulative body of observations. Whenever possible, more than one observing site
					increases the chance of clear skies and the total time spent in totality.
				</p>
				<p>
					In Burgos the teams worked from two places — Padilla de Abajo in the valley, and Pico Trigaza
					on the ridge. The photographs below are from both sites; each caption names the place and the
					photographer. Use the filters to see one site at a time.
				</p>
			</div>

			<div class="exp-gallery-toolbar" role="group" aria-label="Filter photographs by site">
				<button type="button" class="exp-site-btn" data-gallery-filter="all" aria-pressed="true">
					All
				</button>
				<button type="button" class="exp-site-btn" data-gallery-filter="padilla" aria-pressed="false">
					Padilla de Abajo
				</button>
				<button type="button" class="exp-site-btn" data-gallery-filter="trigaza" aria-pressed="false">
					Pico Trigaza
				</button>
			</div>

			<div
				class="exp-burgos-gallery"
				data-lightbox-gallery
				data-burgos-gallery
				role="list"
				aria-label="Burgos expedition photographs from Padilla de Abajo and Pico Trigaza"
			>
				{
					burgosGallery.map((shot) => (
						<figure
							class:list={['exp-burgos-shot', `exp-burgos-shot--${shot.size}`]}
							role="listitem"
							data-site={shot.site}
							style={`--shot-pos: ${shot.position}`}
						>
							<button
								type="button"
								class="exp-burgos-shot-open"
								data-lightbox-trigger
								aria-label={`View larger: ${shot.caption}`}
							>
								<Image
									src={shot.image}
									alt={shot.alt}
									widths={[480, 800, 1200, 1600]}
									sizes={
										shot.size === 'hero' || shot.size === 'wide'
											? '(max-width: 900px) 94vw, 48vw'
											: '(max-width: 900px) 46vw, 28vw'
									}
									loading="lazy"
									class="exp-burgos-photo"
								/>
							</button>
							<figcaption class="exp-burgos-caption" data-lightbox-caption-text>
								{shot.caption}
							</figcaption>
						</figure>
					))
				}
			</div>
		</section>

		<section class="exp-block" id="in-the-field" aria-labelledby="field-heading">
			<div class="page-narrow">
				<p class="label">In the Field</p>
				<h2 id="field-heading">Preparation and observation.</h2>
				<p>
					From assembling the instruments to the minutes on site — Padilla de Abajo and Pico Trigaza,
					side by side.
				</p>
			</div>
			<div class="exp-field-grid" data-lightbox-gallery aria-label="Preparation and observation photographs">
				{
					fieldBeats.map((beat) => (
						<figure class="exp-field-shot" style={`--shot-pos: ${beat.position}`}>
							<button
								type="button"
								class="exp-field-shot-open"
								data-lightbox-trigger
								aria-label={`View larger: ${beat.label}. ${beat.caption}`}
							>
								<Image
									src={beat.image}
									alt={beat.alt}
									widths={[480, 800, 1200]}
									sizes="(max-width: 900px) 46vw, 22vw"
									loading="lazy"
									class="exp-field-photo"
								/>
							</button>
							<figcaption>
								<strong>{beat.label}</strong>
								<span>{beat.note}</span>
								<span class="exp-field-credit" data-lightbox-caption-text>
									{beat.caption}
								</span>
							</figcaption>
						</figure>
					))
				}
			</div>
		</section>

		<section class="exp-block" id="team" aria-labelledby="team-heading">
			<div class="page-narrow">
				<p class="label">The Expedition Team</p>
				<h2 id="team-heading">Who was in the field.</h2>
				<p>The people who took part in the Burgos expedition, listed by observing site.</p>
			</div>

			<div class="exp-team-group">
				<p class="label">Padilla de Abajo</p>
				<ul class="exp-team-grid">
					{
						padillaTeam.map((member) => (
							<li class="exp-team-card">
								<div class="exp-well exp-well--portrait">
									<Image
										src={member.photo}
										alt={member.name}
										widths={[320, 480, 720]}
										sizes="(max-width: 640px) 90vw, (max-width: 900px) 44vw, 22vw"
									/>
								</div>
								<h3>{member.name}</h3>
							</li>
						))
					}
				</ul>
			</div>

			<div class="exp-team-group">
				<p class="label">Pico Trigaza</p>
				<ul class="exp-team-grid">
					{
						trigazaTeam.map((member) => (
							<li class="exp-team-card">
								<div class="exp-well exp-well--portrait exp-well--empty">
									<p class="exp-well-label">Portrait</p>
								</div>
								<h3>{member.name}</h3>
								{'note' in member && member.note ? <p class="exp-team-note">{member.note}</p> : null}
								{'href' in member && member.href ? (
									<a
										class="exp-team-link"
										href={member.href}
										rel="noopener noreferrer"
										target="_blank"
									>
										{member.linkLabel} <span class="cta-arrow" aria-hidden="true">→</span>
									</a>
								) : null}
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="exp-block exp-partners" id="made-possible-by" aria-labelledby="partners-heading">
			<div class="page-narrow">
				<p class="label">Made Possible By</p>
				<h2 id="partners-heading">The support that put this expedition in the field.</h2>
				<p>
					The institutions and partners on this page are the same as those on the rest of the site.
					Local supporters in Valmala will be added when the names are confirmed.
				</p>
			</div>
			<PartnerLogos />
		</section>

		<section class="exp-block exp-podcast" id="podcast" aria-labelledby="podcast-heading" data-podcast>
			<div class="exp-podcast-layout">
				<div class="exp-podcast-copy">
					<p class="label">Podcast</p>
					<h2 id="podcast-heading">{podcast.title}</h2>
					<div class="exp-podcast-byline">
						<figure class="exp-podcast-byline-photo">
							<Image
								src={ignacioAmigo}
								alt="Ignacio Amigo"
								widths={[96, 160, 240]}
								sizes="60px"
							/>
						</figure>
						<p class="exp-podcast-byline-text">
							A conversation recorded by{' '}
							<a href={podcast.authorUrl} rel="noopener noreferrer" target="_blank">{podcast.author}</a>
							, science writer, who spent several days with the expedition in Padilla de Abajo.
						</p>
					</div>
					<p>
						A biochemist by training, he holds a PhD in molecular biology and a degree in science
						journalism. On site he interviewed the scientists, recorded sound, and gathered each
						researcher’s account of the 2026 eclipse.
					</p>
				</div>

				<div class="exp-podcast-langs" data-podcast-langs>
					{
						podcast.languages.map((language, index) => (
							<button
								type="button"
								class="exp-site-btn"
								data-podcast-lang={language.id}
								data-episode={language.episodeId}
								data-spotify={language.spotifyUrl}
								data-iframe-title={language.iframeTitle}
								aria-pressed={index === 0 ? 'true' : 'false'}
							>
								{language.label}
							</button>
						))
					}
				</div>

				<div class="exp-podcast-player">
					<iframe
						data-podcast-frame
						src={`https://open.spotify.com/embed/episode/${podcastDefault.episodeId}?utm_source=generator&theme=0`}
						title={podcastDefault.iframeTitle}
						width="100%"
						height="152"
						allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
						allowfullscreen
						loading="lazy"
					></iframe>
				</div>
				<p class="exp-podcast-listen">
					<a
						data-podcast-listen
						href={podcastDefault.spotifyUrl}
						rel="noopener noreferrer"
						target="_blank"
					>
						Listen on Spotify <span class="cta-arrow" aria-hidden="true">→</span>
					</a>
				</p>
			</div>
		</section>

		<section class="exp-next" id="what-comes-next" aria-labelledby="next-heading">
			<div class="page-narrow">
				<p class="label">What Comes Next</p>
				<h2 id="next-heading">The next totality is 2 August 2027.</h2>
				<p>
					Some images from Burgos have already been processed — they are published on{' '}
					<a href={druckmullerImages} rel="noopener noreferrer" target="_blank">
						Miloslav Druckmüller’s site</a
					>. Reducing the rest of the data has begun, and will take months, if not years.
				</p>
				<p>
					Egypt, the south of Spain near Tarifa, and Tunisia are confirmed for 2 August 2027. The
					exact site in Tunisia is still to be set.
				</p>
				<ul class="exp-next-places">
					{
						nextPlaces.map((place) => (
							<li>
								<span>{place.label}</span>
								<span class="exp-next-status">{place.status}</span>
							</li>
						))
					}
				</ul>
				<div class="exp-next-cta">
					<a class="cta cta--button" href="#contact">
						Talk to us <span class="cta-arrow" aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</section>

		<HomeConnect />

		<dialog class="about-lightbox" data-about-lightbox aria-label="Photo gallery">
			<button type="button" class="about-lightbox-close" data-lightbox-close aria-label="Close gallery">
				<span aria-hidden="true">×</span>
			</button>
			<button
				type="button"
				class="about-lightbox-nav about-lightbox-nav--prev"
				data-lightbox-prev
				aria-label="Previous photo"
			>
				<span aria-hidden="true">‹</span>
			</button>
			<button
				type="button"
				class="about-lightbox-nav about-lightbox-nav--next"
				data-lightbox-next
				aria-label="Next photo"
			>
				<span aria-hidden="true">›</span>
			</button>
			<div class="about-lightbox-stage" data-lightbox-stage>
				<img class="about-lightbox-image" data-lightbox-image alt="" />
				<div class="about-lightbox-meta">
					<p class="about-lightbox-caption" data-lightbox-caption></p>
					<p class="about-lightbox-counter" data-lightbox-counter></p>
				</div>
			</div>
		</dialog>
	</article>
</BaseLayout>
