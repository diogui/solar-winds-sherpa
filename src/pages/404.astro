---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
	<div class="not-found">
		<p class="label">404</p>
		<h1>Outside the path</h1>
		<p class="lead">This page is not on the itinerary.</p>
		<a class="cta" href="/">
			Return home <span class="cta-arrow" aria-hidden="true">→</span>
		</a>
	</div>
</BaseLayout>
