---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import TakeAction from '../components/TakeAction.astro';
import {
	eclipseFrames,
	featuredIds,
	hero,
	instruments,
	nextStep,
	pipeline,
	pipelineIntro,
	publications,
	morePapers,
	questions,
	whyParagraphs,
	type ScienceImage,
} from '../data/science';
import coronaWhite from '../assets/images/papers/corona-structures.jpg';
import padilla2026 from '../assets/images/papers/padilla-2026-corona.jpg';
import sun from '../assets/images/why/sun.jpg';
import corona from '../assets/images/why/corona.jpg';
import prominences from '../assets/images/why/prominences.jpg';
import camerasTotality from '../assets/images/field/burgos-totality.jpg';
import filterRig from '../assets/images/field/latest-instruments.jpg';
import fieldStation from '../assets/images/about/story/computers-night.jpg';
import faroeCamp from '../assets/images/about/story/group-field-2015.jpg';
import boeFig1 from '../assets/images/papers/boe-2018-fig1.png';
import feComposite from '../assets/images/papers/fe-composite.jpg';
import druckmuller2014 from '../assets/images/papers/druckmuller-2014-corona.jpg';
import coronaTrigaza from '../assets/images/expedition/burgos/processed/tse2026-trigaza-800mm.png';
import burgosHorizon from '../assets/images/expedition/burgos/burgos-horizon.jpg';
import '../styles/science.css';

const photos: Record<ScienceImage, ImageMetadata> = {
	'corona-white': coronaWhite,
	'padilla-2026': padilla2026,
	sun,
	corona,
	prominences,
	'cameras-totality': camerasTotality,
	'filter-rig': filterRig,
	'field-station': fieldStation,
	'faroe-camp': faroeCamp,
	'boe-fig1': boeFig1,
	'fe-composite': feComposite,
	'druckmuller-2014': druckmuller2014,
	'corona-trigaza': coronaTrigaza,
};

const featured = featuredIds.map((id) => {
	const paper = publications.find((item) => item.id === id);
	if (!paper) throw new Error(`Missing science publication: ${id}`);
	return paper;
});
---

<BaseLayout
	title="Science"
	description="What Solar Wind Sherpas investigates in the solar corona, how totality is used to record it, and the papers that follow from those observations."
>
	<article class="page science">
		<section class="science-opening" id="questions" aria-labelledby="questions-heading">
			<div class="science-essay">
				<header class="science-intro">
					<p class="label page-kicker">Science</p>
					<h1 id="questions-heading">The questions we explore</h1>
					<p class="lead">
						A total solar eclipse gives a few minutes when the Sun’s outer atmosphere can be
						studied from the ground. These are the questions that work is built around.
					</p>
				</header>

				<figure class="science-figure">
					<div class="science-figure-frame">
						<Image
							src={photos[hero.image]}
							alt={hero.alt}
							widths={[800, 1200, 1600]}
							sizes="(max-width: 900px) 92vw, min(44rem, 55vw)"
							loading="eager"
						/>
					</div>
					<figcaption class="science-caption">
						{hero.caption}
						<span class="science-credit">{hero.credit}</span>
					</figcaption>
				</figure>
			</div>

			<ol class="science-questions" aria-labelledby="questions-heading">
				{
					questions.map((question) => (
						<li class="science-question" id={question.id}>
							<span class="science-question-index">{question.index}</span>
							<h2>{question.title}</h2>
							<p>{question.text}</p>
						</li>
					))
				}
			</ol>
		</section>

		<section class="science-section" id="eclipses" aria-labelledby="eclipses-heading">
			<p class="label">Why eclipses</p>
			<h2 id="eclipses-heading">Why total eclipses matter</h2>
			<div class="science-prose">
				{whyParagraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>
			<ul class="science-compare" aria-label="How totality reveals the corona">
				{
					eclipseFrames.map((frame) => (
						<li>
							<figure>
								<div class="science-compare-frame" style={`--shot-pos: ${frame.position}`}>
									<Image
										src={photos[frame.image]}
										alt={frame.alt}
										widths={[480, 800, 1200]}
										sizes="(max-width: 900px) 92vw, 33vw"
										loading="lazy"
									/>
								</div>
								<figcaption>
									<span class="science-credit">{frame.caption}</span>
									<span class="science-caption">{frame.detail}</span>
								</figcaption>
							</figure>
						</li>
					))
				}
			</ul>
		</section>

		<section class="science-section" id="instruments" aria-labelledby="instruments-heading">
			<p class="label">In the field</p>
			<h2 id="instruments-heading">Equipment &amp; instruments</h2>
			<div class="science-prose">
				<p>
					The expeditions travel with white-light cameras, narrow-band filters tuned to iron emission
					at about 1 and 2 million degrees, and spectrometers built to be carried in the field. They
					are set up on site and used together during totality.
				</p>
			</div>

			{
				instruments.map((instrument) => (
					<article class="science-instrument">
						<figure class="science-instrument-photo">
							<div class="science-instrument-frame" style={`--shot-pos: ${instrument.position}`}>
								<Image
									src={photos[instrument.image]}
									alt={instrument.alt}
									widths={[640, 960, 1400]}
									sizes="(max-width: 900px) 92vw, 36rem"
									loading="lazy"
								/>
							</div>
							<figcaption class="science-caption">
								{instrument.caption}
								<span class="science-credit">{instrument.credit}</span>
							</figcaption>
						</figure>
						<div>
							<h3>{instrument.name}</h3>
							<dl class="science-facts">
								<div>
									<dt>Measures</dt>
									<dd>{instrument.measures}</dd>
								</div>
								<div>
									<dt>Question</dt>
									<dd>{instrument.question}</dd>
								</div>
							</dl>
						</div>
					</article>
				))
			}
		</section>

		<section class="science-section" id="method" aria-labelledby="method-heading">
			<p class="label">How the work proceeds</p>
			<h2 id="method-heading">From observations to knowledge</h2>
			<div class="science-prose">
				<p>{pipelineIntro}</p>
			</div>
			<ol class="science-steps">
				{
					pipeline.map((step) => (
						<li class:list={['science-step', !('image' in step) && 'science-step--text']}>
							<span class="science-step-index">{step.index}</span>
							<div class="science-step-copy">
								<h3>{step.title}</h3>
								<p>{step.text}</p>
								{'legend' in step && (
									<ul class="science-legend">
										{step.legend.map((item) => (
											<li>
												<span
													class:list={['science-swatch', `science-swatch--${item.swatch}`]}
													aria-hidden="true"
												/>
												<span>
													<strong>{item.label}.</strong> {item.text}
												</span>
											</li>
										))}
									</ul>
								)}
								{'link' in step && (
									<a class="cta" href={step.link.href} rel="noopener noreferrer">
										{step.link.label} <span class="cta-arrow" aria-hidden="true">→</span>
									</a>
								)}
							</div>
							{'image' in step && (
								<figure>
									<div class="science-step-frame">
										<Image
											src={photos[step.image]}
											alt={step.alt}
											widths={[640, 1000, 1600]}
											sizes="(max-width: 900px) 92vw, 34rem"
											loading="lazy"
										/>
									</div>
									<figcaption class="science-caption">
										{step.caption}
										<span class="science-credit">{step.credit}</span>
									</figcaption>
								</figure>
							)}
						</li>
					))
				}
			</ol>
		</section>

		<section class="science-section" id="publications" aria-labelledby="publications-heading">
			<p class="label">Results</p>
			<h2 id="publications-heading">Scientific contributions &amp; publications</h2>
			<div class="science-prose">
				<p>
					Three published papers that show the kind of results that follow from the expeditions,
					followed by a short list from the same body of work.
				</p>
			</div>

			<div class="science-features">
				{
					featured.map((paper) => (
						<article
							class:list={['science-feature', !paper.image && 'science-feature--text']}
							id={`publication-${paper.id}`}
						>
							{paper.image && paper.imageAlt && paper.imageCaption && paper.imageCredit && (
								<figure class="science-feature-photo">
									<div class="science-feature-frame">
										<Image
											src={photos[paper.image]}
											alt={paper.imageAlt}
											widths={[640, 1000, 1400]}
											sizes="(max-width: 900px) 92vw, 32rem"
											loading="lazy"
										/>
									</div>
									<figcaption class="science-caption">
										{paper.imageCaption}
										<span class="science-credit">{paper.imageCredit}</span>
									</figcaption>
								</figure>
							)}
							<div>
								<p class="science-status">Published · {paper.year}</p>
								<h3>
									<a href={paper.href} rel="noopener noreferrer">
										{paper.accessibleTitle}
										<span class="cta-arrow" aria-hidden="true">→</span>
									</a>
								</h3>
								<p>{paper.summary}</p>
								<p class="science-official">{paper.title}</p>
								<p class="science-pub-meta">{paper.authors}</p>
								<p class="science-pub-meta">
									{paper.journal} · Vol. {paper.volume}, Issue {paper.issue}, p. {paper.page}
								</p>
								<p class="science-pub-links">
									<a class="science-doi" href={paper.href} rel="noopener noreferrer">
										doi.org/{paper.doi}
									</a>
									{paper.fullTextHref && paper.fullTextLabel && (
										<a class="cta" href={paper.fullTextHref} rel="noopener noreferrer">
											{paper.fullTextLabel}{' '}
											<span class="cta-arrow" aria-hidden="true">
												→
											</span>
										</a>
									)}
								</p>
							</div>
						</article>
					))
				}
			</div>

			<div class="science-more">
				<h3 class="science-more-heading">More papers</h3>
				<ul class="science-more-list">
					{
						morePapers.map((paper) => (
							<li>
								<p class="science-status">Published · {paper.year}</p>
								<h4>
									<a href={paper.href} rel="noopener noreferrer">
										{paper.accessibleTitle}
										<span class="cta-arrow" aria-hidden="true">
											→
										</span>
									</a>
								</h4>
								<p>{paper.summary}</p>
								<p class="science-official">{paper.title}</p>
								<p class="science-pub-meta">
									{paper.authors} · {paper.journal}
								</p>
								<p class="science-pub-links">
									<a class="science-doi" href={paper.href} rel="noopener noreferrer">
										doi.org/{paper.doi}
									</a>
								</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="science-next" id="next" aria-labelledby="next-heading">
			<div class="science-next-inner">
				<div class="science-next-copy">
					<p class="label">
						What comes next <span class="science-tbc">(To be confirmed)</span>
					</p>
					<h2 id="next-heading">{nextStep.title}</h2>
					<p>{nextStep.text}</p>
					<div class="science-next-links">
						<a class="cta cta--button" href={nextStep.expeditionHref}>
							{nextStep.expeditionLabel} <span class="cta-arrow" aria-hidden="true">→</span>
						</a>
						<a class="cta cta--button" href={nextStep.supportHref}>
							{nextStep.supportLabel} <span class="cta-arrow" aria-hidden="true">→</span>
						</a>
					</div>
				</div>
				<figure class="science-next-media">
					<div class="science-next-frame">
						<Image
							src={burgosHorizon}
							alt={nextStep.imageAlt}
							widths={[640, 960, 1400]}
							sizes="(max-width: 900px) 92vw, 40vw"
							loading="lazy"
						/>
					</div>
					<figcaption class="science-credit">{nextStep.imageCredit}</figcaption>
				</figure>
			</div>
		</section>

		<TakeAction />
	</article>
</BaseLayout>
