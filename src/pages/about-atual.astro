const peopleGallery = [
	{
		image: peopleUsa,
		alt: 'Solar Wind Sherpas team in matching blue shirts posing in a grassy field',
		caption: '2024',
		area: 'hero',
		position: '50% 40%',
	},
	{
		image: peopleSpain,
		alt: 'Expedition team on a Spanish ridge with a telescope and open sky behind them',
		caption: 'Foto Klub + Milos, 2026',
		area: 'a',
		position: '50% 42%',
	},
	{
		image: peopleMexicoEight,
		alt: 'Eight expedition members in blue shirts at a field camp with tents',
