		alt: 'Ben calibrating instruments inside a field tent',
		caption: 'Ben on his first expedition · Indonesia, 2016',
		area: 'e',
		position: '50% 42%',
	},
	{
		image: storyGroupSpain,
		alt: 'Team portrait on a grassy ridge with a telescope beside them',
		caption: 'Foto Klub + Milos, 2026',
		area: 'f',
		position: '50% 38%',
	},
	{
		image: storyComputersNight,
		alt: 'Field computers glowing in a darkened operations tent before totality',
		caption: 'USA, 2024',
		area: 'g',
		position: '50% 48%',
	},
	{
		image: storyPeopleHorses,
		alt: 'Petr, Jana and a teammate on horseback among mountain trees',
		caption: 'Petr, Jana and a teammate on horseback, 2017',
		area: 'h',
		position: '50% 40%',
	},
	{
		image: storyPeopleJanaHorses,
		alt: 'Jana working under a cloth at an instrument, with horses nearby',
