---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Partners from '../components/Partners.astro';
import WorkCards from '../components/WorkCards.astro';
import TakeAction from '../components/TakeAction.astro';
import heroSvalbard from '../assets/images/about/svalbard-hero-2015.jpg';
import shadia from '../assets/images/field/shadia-habbal.jpg';
import storySvalbard from '../assets/images/about/story/svalbard-2015.jpg';
import storyGroup2017 from '../assets/images/about/story/group-2017.jpg';
import storyGroupSpain from '../assets/images/about/story/group-spain.jpg';
import storyGroupField2015 from '../assets/images/about/story/group-field-2015.jpg';
import storyPeopleInstruments from '../assets/images/about/story/people-instruments.jpg';
import peopleUsa from '../assets/images/about/people/group-usa-2024.jpg';
import people2021 from '../assets/images/about/people/group-2021.jpg';
import peopleAirport from '../assets/images/about/people/group-airport.jpg';
import peopleMexicoEight from '../assets/images/about/people/group-mexico-eight.jpg';
import peopleMexicoTrio from '../assets/images/about/people/group-mexico-trio.jpg';
import peopleMilos from '../assets/images/about/people/milos-field.jpg';
import peopleGear from '../assets/images/about/people/group-gear-2024.jpg';
import people2017 from '../assets/images/about/people/group-2017.jpg';
import '../styles/work.css';
import '../styles/about.css';

import { latestExpeditionHref } from '../data/site';

const expeditionTeamHref = `${latestExpeditionHref}#team`;

/**
 * Our Story timeline — provisional moments for Danilo review.
 * Each entry needs a readable marker + one line so the sequence is a story, not a mood board.
 */
const storyTimeline = [
	{
		marker: '2015 · Svalbard',
		line: 'Totality on the ice — a campaign that shaped how the Sherpas work in the field.',
		image: storySvalbard,
		alt: 'Total solar eclipse over snow-covered mountains in Svalbard, Norway, with expedition vehicles on the ice',
		position: '50% 38%',
	},
	{
		marker: '2015 · Faroe Islands',
		line: 'Instruments into the path of totality — portable observatories on the coast.',
		image: storyGroupField2015,
		alt: 'Red expedition tent and instruments on a coastal gravel site',
		position: '50% 48%',
	},
	{
		marker: '2017 · On the road',
		line: 'The team grows across campaigns — scientists, engineers and observers sharing the work.',
		image: storyGroup2017,
		alt: 'Large expedition group in red shirts in front of field vehicles',
		position: '50% 45%',
	},
	{
		marker: 'In the field',
		line: 'Prepare, calibrate, wait — the minutes of darkness are too short to fix a problem later.',
		image: storyPeopleInstruments,
		alt: 'Ben calibrating instruments inside a field tent',
		position: '50% 42%',
	},
	{
		marker: '2026 · Burgos',
		line: 'The latest campaign — two sites in Spain, and the work that follows from them.',
		image: storyGroupSpain,
		alt: 'Team portrait on a grassy ridge with a telescope beside them',
		position: '50% 38%',
	},
] as const;

const contributions = [
	{
		title: 'Building the instruments',
		text: 'Developing, adapting and testing the systems used to observe the corona.',
	},
	{
		title: 'Working in the field',
		text: 'Preparing observing sites, calibrating equipment and recording data during totality.',
	},
	{
		title: 'Turning data into knowledge',
		text: 'Processing observations, interpreting the measurements and preparing scientific publications.',
	},
] as const;

const peopleGallery = [
	{
		image: peopleUsa,
		alt: 'Solar Wind Sherpas team in matching blue shirts posing in a grassy field',
		area: 'hero',
		position: '50% 40%',
	},
	{
		image: peopleMilos,
		alt: 'Miloslav Druckmüller standing beside a camera mount on Pico Trigaza',
		area: 'a',
		position: '68% 28%',
		milos: true,
	},
	{
		image: peopleMexicoEight,
		alt: 'Eight expedition members in blue shirts at a field camp with tents',
		area: 'b',
		position: '50% 40%',
	},
	{
		image: peopleMexicoTrio,
		alt: 'Sage, Luke and Carlos in matching expedition shirts in Canatlán',
		area: 'c',
		position: '50% 38%',
	},
	{
		image: people2017,
		alt: 'Large expedition group in red shirts gathered in front of field vehicles',
		area: 'd',
		position: '50% 45%',
	},
	{
		image: peopleAirport,
		alt: 'Team selfie with expedition luggage at an airport arrivals hall',
		area: 'e',
		position: '50% 42%',
	},
	{
		image: peopleGear,
		alt: 'Petr and Matěj behind a dense array of cameras prepared for totality',
		area: 'f',
		position: '48% 48%',
	},
	{
		image: people2021,
		alt: 'Team in cold-weather parkas and life vests aboard a research vessel',
		area: 'g',
		position: '50% 45%',
	},
] as const;

---

<BaseLayout
	title="About"
	description="Solar Wind Sherpas brings together scientists, engineers and observers to study the Sun’s outer atmosphere from the path of totality."
>
	<article class="page about about--chat">
		<section class="about-screen" id="introduction" aria-labelledby="about-heading" data-header-hero>
			<div class="about-screen-media">
				<Image
					src={heroSvalbard}
					alt="Total solar eclipse over snow-covered mountains in Svalbard, Norway, with expedition vehicles on the ice"
					widths={[1200, 1800, 2400]}
					sizes="100vw"
					loading="eager"
					class="about-screen-photo"
				/>
				<div class="about-screen-shade" aria-hidden="true"></div>
			</div>
			<div class="about-screen-copy">
				<p class="label page-kicker">About</p>
				<h1 id="about-heading">An international collaboration following total solar eclipses.</h1>
				<p class="about-intro-lead">
					Solar Wind Sherpas brings together scientists, engineers and observers to study the Sun’s
					outer atmosphere and the origins of the solar wind. Led by solar physicist Dr. Shadia Habbal,
					the collaboration takes portable observatories to the path of totality around the world.
				</p>
				<ul class="about-indicators" aria-label="Research indicators">
					<li>
						<span class="about-indicator-value">31</span>
						<span class="about-indicator-label">years of eclipse research</span>
					</li>
					<li>
						<span class="about-indicator-value">21</span>
						<span class="about-indicator-label">expeditions</span>
					</li>
					<li>
						<span class="about-indicator-value">40+</span>
						<span class="about-indicator-label">peer-reviewed publications</span>
					</li>
				</ul>
			</div>
			<p class="about-screen-credit">
				Svalbard, Norway · © 2015 Miloslav Druckmüller, Peter Aniol
			</p>
		</section>

		<section class="about-founder" id="founder" aria-labelledby="founder-heading">
			<article class="about-card about-featured about-featured--bright reveal">
				<div class="about-card-photo about-featured-photo">
					<Image
						src={shadia}
						alt="Dr. Shadia Habbal smiling in the field"
						widths={[640, 960, 1024]}
						sizes="(max-width: 900px) 92vw, 42vw"
						class="about-card-img about-featured-img"
					/>
				</div>
				<div class="about-card-copy">
					<p class="label">Founder</p>
					<h2 id="founder-heading">Dr. Shadia R. Habbal</h2>
					<p>
						Shadia Habbal founded Solar Wind Sherpas and leads its scientific work. Her research
						explores the solar corona and its connection to the solar wind, bringing together field
						observations, specialized instruments and collaborators across expeditions.
					</p>
					<p class="about-featured-affiliation">
						Institute for Astronomy, University of Hawaiʻi
					</p>
				</div>
			</article>
		</section>

		<section class="about-block" id="our-story" aria-labelledby="story-heading">
			<div class="page-narrow">
				<h2 id="story-heading">Our Story</h2>
				<p>
					Solar Wind Sherpas began as a field science effort: take instruments into the path of
					totality, measure the solar corona, and keep building on what each eclipse reveals.
				</p>

				<dl class="about-origin">
					<div>
						<dt>When</dt>
						<dd>1995 — first campaign on the expedition record</dd>
					</div>
					<div>
						<dt>Who</dt>
						<dd>Founded and led by solar physicist Dr. Shadia R. Habbal</dd>
					</div>
					<div>
						<dt>Purpose</dt>
						<dd>
							Study the Sun’s outer atmosphere and the origins of the solar wind from portable
							observatories placed under totality
						</dd>
					</div>
					<div>
						<dt>The name</dt>
						<dd>
							“Sherpas” points to the expedition work itself: moving heavy optics, preparing sites,
							and helping one another make the most of a few minutes of darkness.
						</dd>
					</div>
				</dl>
			</div>

			<ol class="about-timeline" data-lightbox-gallery aria-label="Our Story timeline">
				{
					storyTimeline.map((moment) => (
						<li class="about-timeline-item">
							<div class="about-timeline-copy">
								<p class="label">{moment.marker}</p>
								<p class="about-timeline-line">{moment.line}</p>
							</div>
							<figure class="about-timeline-shot" style={`--shot-pos: ${moment.position}`}>
								<button
									type="button"
									class="about-timeline-shot-open"
									data-lightbox-trigger
									aria-label={`View larger: ${moment.alt}`}
								>
									<Image
										src={moment.image}
										alt={moment.alt}
										widths={[640, 960, 1200, 1600]}
										sizes="(max-width: 900px) 92vw, 36rem"
										loading="lazy"
										class="about-timeline-photo"
									/>
								</button>
								<span class="visually-hidden" data-lightbox-caption-text>
									{moment.marker}. {moment.line}
								</span>
							</figure>
						</li>
					))
				}
			</ol>
		</section>

		<section class="about-block about-people-chat" id="people" aria-labelledby="people-heading">
			<div class="page-narrow">
				<h2 id="people-heading">The People Behind the Sherpas</h2>
				<p>
					The team changes from one expedition to the next. Each campaign brings together the
					scientists, engineers and observers needed for its instruments and observing sites. Between
					eclipses, work continues through instrument preparation, data processing and scientific
					analysis.
				</p>
			</div>

			<ul class="about-contribution-grid">
				{
					contributions.map((item) => (
						<li>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</li>
					))
				}
			</ul>

			<div
				class="about-people-gallery about-people-gallery--landscape"
				data-lightbox-gallery
				aria-label="The People Behind the Sherpas photographs"
			>
				{
					peopleGallery.map((shot) => (
						<figure
							class:list={[
								'about-people-shot',
								shot.area === 'hero' && 'about-people-shot--wide',
								'milos' in shot && shot.milos && 'about-people-shot--milos',
							]}
							style={`--shot-pos: ${shot.position}`}
						>
							<button
								type="button"
								class="about-people-shot-open"
								data-lightbox-trigger
								aria-label={`View larger: ${shot.alt}`}
							>
								<Image
									src={shot.image}
									alt={shot.alt}
									widths={[480, 800, 1200, 1600, 2000]}
									sizes={
										shot.area === 'hero'
											? '(max-width: 900px) 94vw, 66vw'
											: 'milos' in shot && shot.milos
												? /* CSS zoom + retina — request near-full source */
													'(max-width: 900px) 94vw, 1080px'
												: '(max-width: 900px) 94vw, 32vw'
									}
									loading="lazy"
									class="about-people-photo"
								/>
							</button>
						</figure>
					))
				}
				<a class="about-people-cta-tile" href={expeditionTeamHref}>
					<span class="about-people-cta-tile-text">
						Meet the Burgos 2026 expedition team
						<span class="cta-arrow" aria-hidden="true">→</span>
					</span>
				</a>
			</div>
		</section>

		<section class="about-suite" id="actions" aria-labelledby="actions-heading">
			<div class="about-suite-block">
				<header class="about-suite-head">
					<h2 id="actions-heading">Our Actions</h2>
					<p>
						We bring solar research into the field and share the science of eclipses with the
						communities we meet.
					</p>
				</header>
				<WorkCards outreachHref={false} hideCredits />
			</div>
		</section>

		<Partners
			variant="block"
			id="partners"
			headingId="about-partners-heading"
			label="Partners"
			heading="Partners & Supporters"
			lead="The work of the Sherpas is supported through scientific collaboration, funding, technical contributions and help in the field. These relationships contribute to different stages of the research and to specific expeditions."
			examples={[
				{
					title: 'Scientific collaboration',
					body: 'Partner institutions contribute researchers, analysis and shared observing programmes that strengthen the science behind each campaign.',
				},
				{
					title: 'Research funding',
					body: 'Grants and sponsored programmes help cover instruments, travel and the long analysis work that continues between eclipses.',
				},
				{
					title: 'Instruments and field support',
					body: 'Technical partners and field collaborators supply equipment, logistics and on-site help that make portable observatories possible.',
				},
			]}
		/>

		<dialog class="about-lightbox" data-about-lightbox aria-label="Photo gallery">
			<button type="button" class="about-lightbox-close" data-lightbox-close aria-label="Close gallery">
				<span aria-hidden="true">×</span>
			</button>
			<button
				type="button"
				class="about-lightbox-nav about-lightbox-nav--prev"
				data-lightbox-prev
				aria-label="Previous photo"
			>
				<span aria-hidden="true">‹</span>
			</button>
			<button
				type="button"
				class="about-lightbox-nav about-lightbox-nav--next"
				data-lightbox-next
				aria-label="Next photo"
			>
				<span aria-hidden="true">›</span>
			</button>
			<div class="about-lightbox-stage" data-lightbox-stage>
				<img class="about-lightbox-image" data-lightbox-image alt="" />
				<div class="about-lightbox-meta">
					<p class="about-lightbox-counter" data-lightbox-counter></p>
				</div>
			</div>
		</dialog>

		<TakeAction />
	</article>
</BaseLayout>
