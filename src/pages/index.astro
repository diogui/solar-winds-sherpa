---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeVision from '../components/home/HomeVision.astro';
import HomePartners from '../components/home/HomePartners.astro';
import HomeWhyEclipses from '../components/home/HomeWhyEclipses.astro';
import HomeWork from '../components/home/HomeWork.astro';
import HomeLatest from '../components/home/HomeLatest.astro';
import HomeExpeditions from '../components/home/HomeExpeditions.astro';
import HomeContributions from '../components/home/HomeContributions.astro';
import TakeAction from '../components/TakeAction.astro';
import { site } from '../data/site';
import '../styles/home.css';
import '../styles/work.css';
---

<BaseLayout variant="home" description={site.description}>
	<HomeHero />
	<HomeVision />
	<HomePartners />
	<HomeWork />
	<HomeWhyEclipses />
	<HomeExpeditions />
	<HomeLatest />
	<HomeContributions />
	<TakeAction />
</BaseLayout>
