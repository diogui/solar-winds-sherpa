---
import { aboutVersion, aboutVersionMeta, type AboutVersionId } from '../../data/about-version';

interface Props {
	active: AboutVersionId;
}

const { active } = Astro.props;
const other = active === 'chat' ? aboutVersionMeta.atual : aboutVersionMeta.chat;
const current = aboutVersionMeta[active];
const canonical = aboutVersionMeta[aboutVersion];
---

<aside class="about-version-bar" aria-label="About page version switcher">
	<p class="about-version-bar-copy">
		<strong>{current.label}</strong>
		<span aria-hidden="true">·</span>
		<span>Canonical /about → {canonical.label}</span>
	</p>
	<nav class="about-version-bar-nav" aria-label="Switch About version">
		<a
			href={aboutVersionMeta.atual.path}
			aria-current={active === 'atual' ? 'page' : undefined}
		>
			versao-atual
		</a>
		<a
			href={aboutVersionMeta.chat.path}
			aria-current={active === 'chat' ? 'page' : undefined}
		>
			versao-chat
		</a>
		<a class="about-version-bar-other" href={other.path}>Open {other.label} →</a>
	</nav>
	<p class="about-version-bar-hint">
		Change canonical in <code>src/data/about-version.ts</code>
	</p>
</aside>
