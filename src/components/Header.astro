---
import { Image } from 'astro:assets';
import { navLeft, navRight } from '../data/site';
import logoLockup from '../assets/images/brand/logo-lockup-dark.png';

interface Props {
	variant?: 'home' | 'page';
}

const { variant = 'page' } = Astro.props;
const path = Astro.url.pathname;
---

<header class="site-header" data-header data-variant={variant}>
	<div class="header-fill" aria-hidden="true"></div>
	<div class="logo-well" aria-hidden="true"></div>

	<nav class="header-nav" aria-label="Primary">
		<button
			class="menu-toggle"
			type="button"
			data-menu-toggle
			aria-expanded="false"
			aria-controls="mobile-nav"
			aria-label="Open menu"
		>
			<span></span>
		</button>

		<ul class="nav-cluster nav-cluster--left">
			{
				navLeft.map((item) => (
					<li>
						{item.live ? (
							<a
								class="nav-link"
								href={item.href}
								aria-current={path === item.href ? 'page' : undefined}
							>
								{item.label}
							</a>
						) : (
							<span class="nav-link" aria-disabled="true">
								{item.label}
							</span>
						)}
					</li>
				))
			}
		</ul>

		<a class="brand" href="/" aria-label="Solar Wind Sherpas home">
			<Image
				src={logoLockup}
				alt=""
				class="brand-lockup"
				widths={[220, 360, 520]}
				sizes="168px"
				data-eclipse-target
			/>
		</a>

		<ul class="nav-cluster nav-cluster--right">
			{
				navRight.map((item) => (
					<li>
						{item.live ? (
							<a
								class:list={['nav-link', item.label === 'Support' && 'nav-link--support']}
								href={item.href}
								aria-current={path === item.href ? 'page' : undefined}
							>
								{item.label}
							</a>
						) : (
							<span
								class:list={['nav-link', item.label === 'Support' && 'nav-link--support']}
								aria-disabled="true"
							>
								{item.label}
							</span>
						)}
					</li>
				))
			}
		</ul>
	</nav>
</header>

<div class="mobile-nav" id="mobile-nav" data-mobile-nav aria-hidden="true">
	<ul>
		{
			[...navLeft, ...navRight].map((item) => (
				<li>
					{item.live ? (
						<a
							href={item.href}
							class={item.label === 'Support' ? 'is-support' : undefined}
							aria-current={path === item.href ? 'page' : undefined}
						>
							{item.label}
						</a>
					) : (
						<span aria-disabled="true">{item.label}</span>
					)}
				</li>
			))
		}
	</ul>
</div>
