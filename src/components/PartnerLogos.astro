---
import { Image } from 'astro:assets';
import nasa from '../assets/images/partners/nasa.png';
import nsf from '../assets/images/partners/nsf.png';
import wentworth from '../assets/images/partners/wentworth.png';
import hawaii from '../assets/images/partners/hawaii.png';
import msmt from '../assets/images/partners/msmt.png';
import brno from '../assets/images/partners/brno.png';
import astelco from '../assets/images/partners/astelco.png';
import berlin from '../assets/images/partners/berlin.png';
import electricon from '../assets/images/partners/electricon.svg?url';

interface Props {
	exclude?: string[];
}

const { exclude = [] } = Astro.props;
const skipped = new Set(exclude);

const rowOne = [
	{ id: 'hawaii', src: hawaii, alt: 'Institute for Astronomy, University of Hawaiʻi' },
	{ id: 'wentworth', src: wentworth, alt: 'Wentworth Institute of Technology' },
	{ id: 'nsf', src: nsf, alt: 'National Science Foundation' },
	{ id: 'nasa', src: nasa, alt: 'NASA' },
	{
		id: 'msmt',
		src: msmt,
		alt: 'Ministry of Education, Youth and Sports of the Czech Republic',
	},
].filter((partner) => !skipped.has(partner.id));

const rowTwo = [
	{
		id: 'brno',
		src: brno,
		alt: 'Brno University of Technology, Faculty of Mechanical Engineering',
		variant: 'brno',
	},
	{ id: 'electricon', src: electricon, alt: 'Electrícon', variant: 'electricon' },
	{ id: 'berlin', src: berlin, alt: 'Technische Universität Berlin' },
	{ id: 'astelco', src: astelco, alt: 'ASTELCO Systems' },
].filter((partner) => !skipped.has(partner.id));
---

<div class="home-partners-grid">
	<ul class="home-partners-row">
		{
			rowOne.map((partner) => (
				<li>
					<Image
						src={partner.src}
						alt={partner.alt}
						widths={[200, 320, 480]}
						sizes="160px"
						class="home-partner-logo"
					/>
				</li>
			))
		}
	</ul>
	<ul class="home-partners-row home-partners-row--marks">
		{
			rowTwo.map((partner) => (
				<li>
					{'src' in partner && partner.src ? (
						typeof partner.src === 'string' ? (
							<img
								src={partner.src}
								alt={partner.alt}
								width="227"
								height="95"
								class:list={[
									'home-partner-logo',
									'home-partner-logo--mark',
									partner.variant && `home-partner-logo--${partner.variant}`,
								]}
							/>
						) : (
							<Image
								src={partner.src}
								alt={partner.alt}
								widths={[240, 400, 560]}
								sizes="200px"
								class:list={[
									'home-partner-logo',
									'home-partner-logo--mark',
									partner.variant && `home-partner-logo--${partner.variant}`,
								]}
							/>
						)
					) : (
						<span class="home-partner-pending">{partner.alt}</span>
					)}
				</li>
			))
		}
	</ul>
</div>
