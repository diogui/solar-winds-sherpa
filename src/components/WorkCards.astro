---
import { Image } from 'astro:assets';
import researchPhoto from '../assets/images/work/research.jpg';
import expeditionsPhoto from '../assets/images/work/expeditions.jpg';
import outreachPhoto from '../assets/images/work/outreach.jpg';
import { homeOnlyPreview } from '../data/site';

interface Props {
	outreachHref?: string | false;
}

const { outreachHref = homeOnlyPreview ? '/#who-we-are' : '/about' } = Astro.props;

const fronts = [
	{
		title: 'Scientific Research',
		text: 'We use specialized instruments to study the solar corona. By analyzing its light, we investigate its temperature, structure and connection to the solar wind, adding observations that complement those made by space-based observatories.',
		href: homeOnlyPreview ? '/#why-eclipses' : '/science',
		cta: 'Explore the science',
		image: researchPhoto,
		alt: 'A Solar Wind Sherpas team member studies an eclipse image on a camera in the field',
		variant: 'research',
	},
	{
		title: 'Eclipse Expeditions',
		text: 'Observing a total solar eclipse starts long before totality. We select observing sites, prepare instruments and bring people and equipment into the field, ready to make the most of a brief opportunity to study the corona.',
		href: homeOnlyPreview ? '/#latest-expedition' : '/expeditions',
		cta: 'Explore our expeditions',
		image: expeditionsPhoto,
		alt: 'Telescopes set up on a ridge in Spain at sunset, ready for eclipse observations',
		variant: 'expeditions',
		credit: 'Václav Široký',
	},
	{
		title: 'Education & Outreach',
		text: 'We share eclipse science with communities where our expeditions take us. Through talks and educational activities, we explain what happens during an eclipse, introduce our research and help people understand how to observe the event safely.',
		href: outreachHref || undefined,
		cta: 'Discover our outreach',
		image: outreachPhoto,
		alt: 'An evening public talk in a village square, with a lunar eclipse projected for the audience',
		variant: 'outreach',
	},
] as const;
---

<div class="home-work-grid">
	{
		fronts.map((front) => (
			<article class="home-work-card reveal">
				<div class="home-work-photo">
					<Image
						src={front.image}
						alt={front.alt}
						widths={[480, 800, 1200]}
						sizes="(max-width: 900px) 100vw, 33vw"
						class:list={['home-work-img', `home-work-img--${front.variant}`]}
					/>
					{'credit' in front && <p class="home-work-credit">{front.credit}</p>}
				</div>
				<div class="home-work-text">
					<h3>{front.title}</h3>
					<p>{front.text}</p>
					{
						front.href && (
							<a class="cta" href={front.href}>
								{front.cta} <span class="cta-arrow" aria-hidden="true">
									→
								</span>
							</a>
						)
					}
				</div>
			</article>
		))
	}
</div>
