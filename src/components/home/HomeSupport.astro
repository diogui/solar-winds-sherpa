---
import { supportLinks } from '../../data/site';
import '../../styles/support.css';
---

<section class="home-support" id="support" aria-labelledby="invite-heading">
	<div class="home-support-inner">
		<div class="home-support-copy reveal">
			<p class="label">Support our work</p>
			<h2 id="invite-heading">Help make eclipse science possible.</h2>
			<p>
				If you or your organization would like to help sustain future expeditions and scientific
				research, <a href="#contact">we would welcome a conversation</a>.
			</p>
			<p>
				You can also support the project in a way that works for you: join us on Patreon for
				ongoing support, or make a one-time contribution through Buy Me a Coffee. Every contribution
				helps us carry this work forward.
			</p>
		</div>

		<ul class="home-support-funds reveal">
			<li>
				<p class="home-support-fund-title">Expedition sponsorship</p>
				<p>Travel, field equipment, and operations across observing sites.</p>
			</li>
			<li>
				<p class="home-support-fund-title">Data analysis</p>
				<p>The years of work that turn eclipse observations into papers.</p>
			</li>
			<li>
				<p class="home-support-fund-title">Instrumentation</p>
				<p>Spectrometers, filters and cameras built for the path of totality.</p>
			</li>
			<li>
				<p class="home-support-fund-title">Early-career scientists</p>
				<p>Students and researchers who learn this science in the field.</p>
			</li>
		</ul>

		<div class="home-support-give reveal">
			{
				supportLinks.map((link) => (
					<a class="cta cta--button" href={link.href} rel="noopener noreferrer" target="_blank">
						{link.label} <span class="cta-arrow" aria-hidden="true">→</span>
					</a>
				))
			}
		</div>
	</div>
</section>
