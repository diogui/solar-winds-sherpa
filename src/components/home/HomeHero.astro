---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

const hasVideo = existsSync(resolve('./public/media/hero/hero-clean.mp4'));
---

<section class="home-hero" data-hero aria-label="Introduction">
	<div class="home-hero-media">
		<picture class="home-hero-poster">
			<img
				src="/media/hero/hero-poster.jpg"
				width="1600"
				height="900"
				alt="Total solar eclipse over the Burgos observing ridge at dusk"
				class="home-hero-still"
				fetchpriority="high"
				decoding="async"
			/>
		</picture>
		{
			hasVideo && (
				<video
					class="home-hero-video"
					data-hero-video
					muted
					loop
					playsinline
					preload="none"
					disablepictureinpicture
					aria-hidden="true"
				></video>
			)
		}
		<div class="home-hero-shade" aria-hidden="true"></div>
		{
			hasVideo && (
				<div class="home-hero-annotation" data-hero-annotation hidden aria-hidden="true">
					<svg
						class="home-hero-annotation-svg"
						data-hero-svg
						aria-hidden="true"
						focusable="false"
					>
						<circle cx="0" cy="0" r="0" />
						<line x1="0" y1="0" x2="0" y2="0" visibility="hidden" />
					</svg>
					<div class="home-hero-annotation-card" data-hero-caption>
						<p class="home-hero-annotation-title">Total Solar Eclipse</p>
						<p class="home-hero-annotation-meta">Location: Burgos, Spain</p>
						<p class="home-hero-annotation-meta">Duration: 1 min 40 seconds</p>
					</div>
				</div>
			)
		}
	</div>

	<div class="home-hero-copy">
		<h1 class="home-hero-name">
			<span>Solar</span>
			<span>Wind</span>
			<span>Sherpas</span>
		</h1>
		<p class="home-hero-question">What are the origins of the solar wind?</p>
		<a class="cta home-hero-cta" href="#who-we-are">
			Discover Who We Are <span class="cta-arrow cta-arrow--down" aria-hidden="true">↓</span>
		</a>
	</div>

	{
		hasVideo && (
			<button class="home-hero-pause" type="button" data-hero-pause aria-pressed="false">
				Pause video
			</button>
		)
	}
</section>
