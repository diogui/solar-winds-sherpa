---
import { Image } from 'astro:assets';
import sun from '../../assets/images/why/sun.jpg';
import corona from '../../assets/images/why/corona.jpg';
import prominences from '../../assets/images/why/prominences.jpg';
import { homeOnlyPreview } from '../../data/site';

const frames = [
	{
		image: sun,
		alt: 'The uneclipsed Sun, a bright orange disk whose glare hides the corona',
		stage: '0',
		variant: 'sun',
	},
	{
		image: corona,
		alt: 'Total solar eclipse, with the Moon covering the Sun and the corona glowing around it',
		stage: '1',
		variant: 'corona',
	},
	{
		image: prominences,
		alt: 'The Moon’s limb during totality, with pink prominences and a sliver of chromosphere',
		stage: '2',
		variant: 'prominences',
	},
] as const;
---

<section class="home-why" id="why-eclipses" data-why-section aria-labelledby="why-heading">
	<div class="home-why-pin">
		<div class="home-why-copy">
			<p class="label">Why we follow eclipses</p>
			<h2 id="why-heading">The Moon reveals what sunlight hides.</h2>
			<p>
				The corona is the Sun’s outer atmosphere. Its faint visible light is usually lost in the
				glare of the solar surface. During a total solar eclipse, the Moon blocks that glare, giving
				us a rare opportunity to study the corona from Earth.
			</p>

			<div class="home-why-steps" data-why-steps>
				<div class="home-why-progress" aria-hidden="true">
					<span class="home-why-progress-bar"></span>
				</div>
				<button type="button" class="home-why-step is-active" data-why-step="0" aria-pressed="true">
					<span class="home-why-step-index">01</span>
					<span class="home-why-step-title">Hidden in the glare</span>
					<span class="home-why-step-body">
						The corona is always there. The Sun’s bright surface usually overwhelms its faint
						visible light.
					</span>
				</button>
				<button type="button" class="home-why-step is-locked" data-why-step="1" aria-pressed="false">
					<span class="home-why-step-index">02</span>
					<span class="home-why-step-title">Revealed by the Moon</span>
					<span class="home-why-step-body">
						During totality, the Moon covers the Sun’s bright disk, revealing the corona around it.
					</span>
				</button>
				<button type="button" class="home-why-step is-locked" data-why-step="2" aria-pressed="false">
					<span class="home-why-step-index">03</span>
					<span class="home-why-step-title">A window for science</span>
					<span class="home-why-step-body">
						Prominences appear at the Moon’s limb — plasma structures we measure during the few
						minutes of totality.
					</span>
				</button>
			</div>

			<p class="home-why-note">
				Eclipse observations complement measurements from spacecraft and instruments that study the
				corona throughout the year.
			</p>
			<a class="cta" href={homeOnlyPreview ? '/#papers-heading' : '/science'}>
				Explore the science <span class="cta-arrow" aria-hidden="true">→</span>
			</a>
		</div>

		<div class="home-why-visual">
			<div class="home-why-figure" data-why-figure data-stage="0">
				<div class="why-photo-stage">
					{
						frames.map((frame) => (
							<Image
								src={frame.image}
								alt={frame.alt}
								widths={[640, 960, 1400]}
								sizes="(max-width: 900px) 80vw, 28rem"
								class:list={['why-photo', `why-photo--${frame.variant}`]}
								data-why-frame={frame.stage}
							/>
						))
					}
					<svg
						class="why-photo-callouts"
						viewBox="0 0 100 100"
						aria-hidden="true"
						focusable="false"
					>
						<defs>
							<marker
								id="why-arrowhead"
								viewBox="0 0 10 10"
								refX="8.6"
								refY="5"
								markerWidth="2.6"
								markerHeight="2.6"
								orient="auto"
								markerUnits="userSpaceOnUse"
							>
								<path d="M1.2 1.6 L8.8 5 L1.2 8.4 Z" fill="var(--accent)"></path>
							</marker>
						</defs>
						<g class="why-callout why-callout--corona">
							<circle
								class="why-corona-outline"
								cx="51.2"
								cy="49.1"
								r="21.6"
								pathLength="100"
							></circle>
							<path
								class="why-callout-arrow"
								d="M79.4 7.2 C74.6 9.8 68.8 20.4 63.9 31.7"
								marker-end="url(#why-arrowhead)"
							></path>
							<circle class="why-callout-dot" cx="79.4" cy="7.2" r="0.7"></circle>
							<text x="76.8" y="5.8" text-anchor="end">Solar corona</text>
						</g>
						<g class="why-callout why-callout--prominence">
							<ellipse
								class="why-prominence-outline"
								cx="30"
								cy="50.3"
								rx="3.2"
								ry="2.7"
							></ellipse>
							<ellipse
								class="why-prominence-outline"
								cx="64.8"
								cy="60.7"
								rx="3.3"
								ry="4.8"
								transform="rotate(22 64.8 60.7)"
							></ellipse>
							<path
								class="why-callout-arrow"
								d="M12 88.2 C16.5 79.2 22.8 64.4 28.2 53.2"
								marker-end="url(#why-arrowhead)"
							></path>
							<circle class="why-callout-dot" cx="12" cy="88.2" r="1.15"></circle>
							<text x="16" y="93.4">Prominences</text>
						</g>
					</svg>
				</div>
			</div>
			<p class="home-why-caption is-in" data-why-caption>Hidden in the glare</p>
			<p class="home-why-scroll-hint" data-why-hint>
				Scroll to reveal the corona <span aria-hidden="true">↓</span>
			</p>
		</div>
	</div>
</section>
