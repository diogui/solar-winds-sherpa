---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

const hasVideo = existsSync(resolve('./public/media/hero-v1/hero-desktop-1280.mp4'));
---

<section class="home-hero" data-hero aria-label="Introduction">
	<div class="home-hero-media">
		<picture class="home-hero-poster">
			<source
				media="(max-width: 767px) and (orientation: portrait)"
				srcset="/media/hero-v1/poster-mobile.jpg"
				width="720"
				height="1280"
			/>
			<img
				src="/media/hero-v1/poster-desktop.jpg"
				width="1600"
				height="900"
				alt="Solar Wind Sherpas instruments set up on a ridge at dusk"
				class="home-hero-still"
				fetchpriority="high"
				decoding="async"
			/>
		</picture>
		{
			hasVideo && (
				<video
					class="home-hero-video"
					data-hero-video
					muted
					loop
					playsinline
					preload="none"
					disablepictureinpicture
					aria-hidden="true"
				></video>
			)
		}
		<div class="home-hero-shade" aria-hidden="true"></div>
	</div>

	<div class="home-hero-copy">
		<p class="label">Solar Wind Sherpas</p>
		<h1>What are the origins of the solar wind?</h1>
		<p class="home-hero-mission">
			We follow total solar eclipses to study the Sun’s outer atmosphere and the origins of the
			solar wind.
		</p>
		<a class="cta home-hero-cta" href="#who-we-are">
			Discover Who We Are <span class="cta-arrow cta-arrow--down" aria-hidden="true">↓</span>
		</a>
	</div>

	{
		hasVideo && (
			<button class="home-hero-pause" type="button" data-hero-pause aria-pressed="false">
				Pause video
			</button>
		)
	}
</section>
