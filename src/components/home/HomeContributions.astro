---
import { Image } from 'astro:assets';
import habbal from '../../assets/images/papers/padilla-2026-corona.jpg';
import structures from '../../assets/images/papers/card-structures.jpg';
import freezeIn from '../../assets/images/papers/card-freeze.jpg';

const papers = [
	{
		kicker: 'Habbal et al. · 2026 · ApJ',
		title: 'Tracking plasma instabilities into space',
		text: 'Eclipse images first showed vortex-ring structures near the Sun. Combined with Parker Solar Probe white-light data, this work follows those structures outward and finds speeds that match the slow solar wind — evidence that they survive as they expand away from the Sun.',
		original:
			'Tracking the Evolution of Plasma Instabilities from the Prominence–Corona Transition Region into Interplanetary Space with Total Solar Eclipse and PSP/WISPR White Light Images',
		cta: 'View publication',
		href: 'https://doi.org/10.3847/1538-4357/ae2ec7',
		external: true,
		image: habbal,
		alt: 'Processed white-light image of the solar corona during the 2026 eclipse, showing fine streamers around the Moon',
		variant: 'habbal',
	},
	{
		kicker: 'Druckmüller et al. · 2014 · ApJ',
		title: 'Revealing fine structures in the corona',
		text: 'Detailed processing of eclipse images revealed faint loops, rings and twisted structures, providing new evidence of the corona’s dynamic behavior.',
		original: 'Discovery of a New Class of Coronal Structures in White Light Eclipse Images',
		cta: 'View publication',
		href: 'https://doi.org/10.1088/0004-637X/785/1/14',
		external: true,
		image: structures,
		alt: 'Processed white-light eclipse image showing fine streamers and a prominence in the solar corona',
		variant: 'structures',
	},
	{
		kicker: 'Boe et al. · 2018 · ApJ',
		title: 'Tracing the solar wind’s origins',
		text: 'Observations from the 2015 eclipse helped identify where two types of iron ions settle into the charge states they carry outward with the solar wind, offering clues to conditions near the Sun.',
		original:
			'The First Empirical Determination of the Fe¹⁰⁺ and Fe¹³⁺ Freeze-in Distances in the Solar Corona',
		cta: 'View publication',
		href: 'https://doi.org/10.3847/1538-4357/aabfb7',
		external: true,
		image: freezeIn,
		alt: 'Composite eclipse image of the solar corona, with Fe XI emission in red and Fe XIV in green',
		variant: 'freeze',
	},
] as const;
---

<section class="home-papers" id="contributions" aria-labelledby="papers-heading">
	<div class="home-papers-head reveal">
		<p class="label">Scientific contributions</p>
		<a class="home-papers-all" href="/science#publications">View all</a>
		<h2 id="papers-heading">From eclipse observations to scientific knowledge.</h2>
	</div>

	<div class="home-papers-grid">
		{
			papers.map((paper) => (
				<article class="home-papers-card reveal">
					<div class="home-papers-photo">
						<Image
							src={paper.image}
							alt={paper.alt}
							widths={[480, 800, 1200]}
							sizes="(max-width: 900px) 100vw, 33vw"
							class:list={['home-papers-img', `home-papers-img--${paper.variant}`]}
						/>
					</div>
					<div class="home-papers-text">
						<p class="home-papers-kicker">{paper.kicker}</p>
						<a
							class="home-papers-title"
							href={paper.href}
							{...(paper.external ? { rel: 'noopener noreferrer' } : {})}
						>
							<h3>{paper.title}</h3>
							<span class="cta-arrow" aria-hidden="true">
								→
							</span>
						</a>
						<p>{paper.text}</p>
						<p class="home-papers-original">{paper.original}</p>
						<a
							class="cta"
							href={paper.href}
							{...(paper.external ? { rel: 'noopener noreferrer' } : {})}
						>
							{paper.cta} <span class="cta-arrow" aria-hidden="true">→</span>
						</a>
					</div>
				</article>
			))
		}
	</div>
</section>
