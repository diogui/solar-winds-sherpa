---
import { Image } from 'astro:assets';
import field from '../../assets/images/field/latest-camp.jpg';
import { burgosFilm } from '../../data/media';
import { latestExpeditionHref } from '../../data/site';

const hasFilm = true;
const videoSrc = burgosFilm.full;
const videoSrcLight = burgosFilm.light;
const posterSrc = '/media/latest/burgos-poster.jpg';
---

<section
	class="home-latest"
	id="latest-expedition"
	aria-labelledby="latest-heading"
	data-latest-film={hasFilm ? '' : undefined}
	data-latest-mode={hasFilm ? 'photos' : undefined}
	data-latest-src={hasFilm ? videoSrc : undefined}
	data-latest-src-light={hasFilm ? videoSrcLight : undefined}
>
	<!-- Review: photographer credit — Václav Široký; film by Santiago Marrodán Ciordia -->
	<div class="home-latest-frame">
		<figure class="home-latest-shot">
			<Image
				src={field}
				alt="Two team members in purple expedition shirts at the Burgos field camp, beside grey observation tents"
				widths={[640, 960, 1024]}
				sizes="(max-width: 900px) 92vw, 70vw"
				class="home-latest-photo"
			/>
			{
				hasFilm && (
					<>
						<video
							class="home-latest-video"
							data-latest-video
							muted
							playsinline
							preload="none"
							poster={posterSrc}
							aria-label="Burgos expedition film"
						></video>
						<div class="home-latest-transport" data-latest-transport>
							<button
								type="button"
								class="home-latest-play"
								data-latest-play
								aria-label="Pause video"
								aria-pressed="false"
							>
								<span data-latest-play-label>Pause</span>
							</button>
							<button
								type="button"
								class="home-latest-mute"
								data-latest-mute
								aria-label="Unmute sound"
								aria-pressed="true"
							>
								<span class="home-latest-mute-icon" aria-hidden="true">
									<svg class="home-latest-mute-on" viewBox="0 0 24 24" width="18" height="18" fill="none">
										<path d="M4 10.5v3h3.2L11 17V7L7.2 10.5H4Z" fill="currentColor"></path>
										<path
											d="M14.2 9.2a3.6 3.6 0 0 1 0 5.6M16.6 7a6.4 6.4 0 0 1 0 10"
											stroke="currentColor"
											stroke-width="1.7"
											stroke-linecap="round"
										></path>
									</svg>
									<svg class="home-latest-mute-off" viewBox="0 0 24 24" width="18" height="18" fill="none">
										<path d="M4 10.5v3h3.2L11 17V7L7.2 10.5H4Z" fill="currentColor"></path>
										<path
											d="M15 9.5 20 14.5M20 9.5 15 14.5"
											stroke="currentColor"
											stroke-width="1.7"
											stroke-linecap="round"
										></path>
									</svg>
								</span>
							</button>
						</div>
						<div class="home-latest-controls">
							<button
								type="button"
								class="home-latest-switch"
								data-latest-toggle
								role="switch"
								aria-checked="true"
							>
								<span>Film</span>
								<span class="home-latest-switch-track" aria-hidden="true">
									<span class="home-latest-switch-thumb"></span>
								</span>
								<span>Photo</span>
							</button>
							<div
								class="home-latest-load"
								data-latest-load
								role="progressbar"
								aria-label="Film download"
								aria-valuemin="0"
								aria-valuemax="100"
								aria-valuenow="0"
							>
								<span class="home-latest-load-bar" data-latest-load-bar></span>
							</div>
						</div>
					</>
				)
			}
		</figure>

		<div class="home-latest-copy reveal">
			<div class="home-latest-intro">
				<p class="label">Latest expedition · 2026</p>
				<h2 id="latest-heading">Burgos, Spain</h2>
			</div>
			<div class="home-latest-body">
				<p>
					In 2026, our pursuit of total solar eclipses brought us to Burgos, Spain. Discover the
					setting, the preparation and the people behind this expedition, and the scientific questions
					that brought us into the field.
				</p>
				<a class="cta cta--button" href={latestExpeditionHref}>
					Explore the expedition <span class="cta-arrow" aria-hidden="true">→</span>
				</a>
				{hasFilm && <p class="home-latest-credit">Film by Santiago Marrodán Ciordia</p>}
			</div>
		</div>
	</div>
</section>
