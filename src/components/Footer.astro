---
import { Image } from 'astro:assets';
import logoLockup from '../assets/images/brand/logo-lockup-dark.png';
import logoMark from '../assets/images/brand/logo-mark-color.png';
import { navLeft, navRight, site } from '../data/site';
---

<footer class="site-footer">
	<div class="footer-orbit" aria-hidden="true"></div>
	<div class="footer-mark" aria-hidden="true">
		<Image src={logoMark} alt="" class="footer-watermark" widths={[320, 480, 640]} sizes="15rem" />
	</div>

	<div class="footer-inner">
		<div class="footer-brand">
			<a href="/" class="footer-logo-link" aria-label="Solar Wind Sherpas home">
				<Image
					src={logoLockup}
					alt=""
					class="footer-lockup"
					widths={[360, 560, 800]}
					sizes="(max-width: 900px) 13rem, 16rem"
				/>
			</a>
			<p class="footer-tagline">{site.tagline}</p>
		</div>

		<nav class="footer-nav" aria-label="Footer">
			<p class="footer-kicker">Explore</p>
			<ul class="footer-links">
				{
					navLeft.map((item) => (
						<li>
							{item.live ? (
								<a href={item.href}>{item.label}</a>
							) : (
								<span aria-disabled="true">{item.label}</span>
							)}
						</li>
					))
				}
			</ul>
		</nav>

		<div class="footer-support">
			<p class="footer-kicker">Support</p>
			<p class="footer-support-copy">Help make the next totality possible.</p>
			{
				navRight
					.filter((item) => item.label === 'Support')
					.map((item) => (
					<a class="cta cta--button" href={item.href}>
						{item.label} <span class="cta-arrow" aria-hidden="true">→</span>
					</a>
					))
			}
		</div>
	</div>

	<div class="footer-base">
		<p>Solar Wind Sherpas</p>
		<p class="footer-meta">Eclipse photograph from the Solar Wind Sherpas archive.</p>
	</div>
</footer>
