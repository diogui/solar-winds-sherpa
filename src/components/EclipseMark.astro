---
import logoMark from '../assets/images/brand/logo-mark.png';

interface Props {
	id: string;
	class?: string;
}

const { class: className } = Astro.props;
---

<img
	src={logoMark.src}
	alt=""
	width={logoMark.width}
	height={logoMark.height}
	class:list={['eclipse-mark', className]}
	decoding="async"
/>
